# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Countdown target date (ISO 8601, optional — defaults to 14 days from first visit)
# NEXT_PUBLIC_COUNTDOWN_TARGET=2025-05-18T00:00:00Z
